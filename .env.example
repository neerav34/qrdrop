# URL of the signaling server the browser connects to.
# Local dev: http://localhost:4000 — production: your Railway URL.
NEXT_PUBLIC_SIGNAL_URL=http://localhost:4000

# Set by Next itself ("development" / "production") — never set it by hand.
# Anything other than "production" exposes a test hook used by test/e2e.test.mjs
# to simulate a dropped link.
NODE_ENV=development

# --- test-only overrides (see test/) ---
# Signaling server that test/signal.test.mjs talks to.
SIGNAL_URL=http://localhost:4000
# Origin that test/e2e.test.mjs drives in a real browser.
E2E_URL=http://localhost:3000
# Browser binary for test/e2e.test.mjs.
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
