# Port the signaling server listens on. Railway injects its own PORT.
PORT=4000

# Comma-separated origins allowed to connect. Set this in production to your
# Vercel domain, e.g. https://qrdrop.vercel.app
# Left unset, every origin is accepted — fine for local dev, not for production.
ALLOWED_ORIGINS=

# Set to "production" on Railway. When it is anything else, private-network
# origins (192.168.x, 10.x, localhost) are also allowed so LAN testing works.
NODE_ENV=development

# --- TURN (optional): relays the file when the two devices cannot reach each
# other directly — different networks, or a Wi-Fi that blocks device-to-device
# traffic. Leave all of it unset and QRDrop still works whenever a direct path
# exists, which is the same-Wi-Fi and hotspot cases.
#
# Relay is a last resort, never a default: ICE ranks relay candidates below
# direct ones, so relay bandwidth is only spent on transfers that would
# otherwise have failed outright.
#
# Option A — any provider with fixed credentials (Metered Open Relay,
# self-hosted coturn). Simplest, and needs no card with Metered's free tier.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Option B — Cloudflare, which mints short-lived credentials from a key that
# stays here on the server and never reaches the browser. 1,000 GB/month free,
# but requires a card on the account.
TURN_KEY_ID=
TURN_API_TOKEN=
# Lifetime of each minted credential, seconds. Max 172800 (48h).
TURN_TTL_SECONDS=43200
# Only for testing against a stub provider; leave unset in production.
TURN_API_BASE=
